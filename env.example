# Referencia de configuración. No subir un .env con credenciales.
# GoDaddy proporciona DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD
# automáticamente. No volver a crearlos ni sobrescribirlos con valores vacíos.
# Estos ejemplos comentados solo sirven para una base de desarrollo propia:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# Conservar la contraseña actual del panel en los secretos de GoDaddy:
ADMIN_PASSWORD=
# Valor por entorno: pruebas para Vista previa; publicado para Publicado.
SHOP_CATALOG_ID=
# Opcionales según la configuración del proveedor:
APP_URL=
# DB_SSL=true
# DB_SSL_CA=
# DATA_DIR solo sirve para localizar un catálogo antiguo al importarlo.
# No se utiliza para guardar nuevos datos en GoDaddy.
# Funciones de clientes (activar cuando decidas ponerlas en producción):
# COMMERCE_ENABLED=true
# COMMERCE_KEY=<salida de node generate-commerce-key.cjs>
